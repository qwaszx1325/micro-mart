# 服務配置
SERVICE_NAME=user-service
SERVICE_URL=:5000

# OTEL 配置 (Jaeger)
OTEL_URL=jaeger:4317

# Redis 配置
REDIS_URL=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_ACTIVE_CONNS=10
REDIS_MIX_IDLE_CONNS=3
REDIS_MAX_IDLE_CONNS=5
REDIS_CONN_TIMEOUT_SECS=5

# 資料庫配置 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASS=qwaszx1325
DB_NAME=user_db
DB_MAX_CONN=10
DB_MAX_IDLE=5
DB_MAX_CONN_LIFE_SECS=300
AUTO_MIGRATE=true

# 驗證配置
VERIFICATION_TOKEN_EXPIRY=3600
VERIFICATION_TOKEN_LOCK_PREIOD=300
VERIFICATION_TOKEN_COUNT_PREIOD=86400
VERIFICATION_TOKEN_NOTIFY_LOCK_PREIOD=300
VERIFICATION_TOKEN_TOTAL_ATTEMPTS=5